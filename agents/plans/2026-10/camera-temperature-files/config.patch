@@ -0,0 +1,89 @@
+##################################
+# Powered cameras must be locked onto their required EM-gain temperatures.
+# Keep numeric targets below equal to camera.emGainTemp in each camera config.
+# camsci1-power-on and camsci2-power-on are defined in camsci1notop.conf
+# and camsci2notop.conf, respectively.
+
+[camwfs-power-on]
+ruleType=txtVal
+property=pdu1.camwfs
+element=state
+target=On
+
+[camwfs-temp-locked]
+ruleType=txtVal
+property=camwfs.temp_control
+element=status
+target=ON TARGET
+
+[camwfs-temp-setpoint-expected]
+ruleType=numVal
+property=camwfs.temp_ccd
+element=target
+target=-45
+tol=0
+
+[camwfs-temp-not-ready]
+ruleType=ruleComp
+rule1=camwfs-temp-locked
+rule2=camwfs-temp-setpoint-expected
+comp=Nand
+
+[camwfs-on-temp-not-ready]
+ruleType=ruleComp
+priority=caution
+message=camwfs temperature is not on target at -45 C
+rule1=camwfs-power-on
+rule2=camwfs-temp-not-ready
+
+[camsci1-temp-locked]
+ruleType=txtVal
+property=camsci1.temp_control
+element=status
+target=LOCKED
+
+[camsci1-temp-setpoint-expected]
+ruleType=numVal
+property=camsci1.temp_ccd
+element=target
+target=-50
+tol=0
+
+[camsci1-temp-not-ready]
+ruleType=ruleComp
+rule1=camsci1-temp-locked
+rule2=camsci1-temp-setpoint-expected
+comp=Nand
+
+[camsci1-on-temp-not-ready]
+ruleType=ruleComp
+priority=caution
+message=camsci1 temperature is not locked at -50 C
+rule1=camsci1-power-on
+rule2=camsci1-temp-not-ready
+
+[camsci2-temp-locked]
+ruleType=txtVal
+property=camsci2.temp_control
+element=status
+target=LOCKED
+
+[camsci2-temp-setpoint-expected]
+ruleType=numVal
+property=camsci2.temp_ccd
+element=target
+target=-55
+tol=0
+
+[camsci2-temp-not-ready]
+ruleType=ruleComp
+rule1=camsci2-temp-locked
+rule2=camsci2-temp-setpoint-expected
+comp=Nand
+
+[camsci2-on-temp-not-ready]
+ruleType=ruleComp
+priority=caution
+message=camsci2 temperature is not locked at -55 C
+rule1=camsci2-power-on
+rule2=camsci2-temp-not-ready
