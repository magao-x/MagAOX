# Makefile for xctrl, which needs the C++ standard library, flatlogs and the log headers generated by libMagAOX

SELF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
include $(SELF_DIR)/../../Make/common.mk

TARGET = xctrl

# xctrl writes MagAO-X binary logs: the text_log code and schema come from the libMagAOX build.  flatlogs includes
# mxlib headers, which need mxlib's flags (its include/mx directory and C++ standard) from pkg-config, as every app has
LOGGEN = ../../libMagAOX/logger/generated/logCodes.hpp ../../libMagAOX/logger/types/generated/string_log_generated.h

all: $(TARGET)

$(TARGET): xctrl.cpp xctrl.hpp xctrlLog.hpp ../../libMagAOX/common/paths.hpp ../../libMagAOX/common/defaults.hpp $(LOGGEN)
	$(CXX) $(MXLIB_CFLAGS) -O2 -Wall -Wextra $(INCLUDES) -o $@ xctrl.cpp

$(LOGGEN):
	@echo "xctrl needs $@: build libMagAOX first (make libs_all in the MagAOX directory)"; exit 1

# bash completion of commands, options, roles and apps: bash-completion loads it from here the first time xctrl is
# completed, for users whose ~/.bashrc enables bash-completion; the profile.d hook loads it for every other user
COMPLETIONS_DIR ?= /usr/share/bash-completion/completions

# the root-owned allow lists of [systemd] directives: the defaults, always overwritten, and the local copy xctrl
# reads first, a copy of the defaults made only if it does not exist
ALLOW_DIR     = /etc/magaox
ALLOW_DEFAULT = $(ALLOW_DIR)/systemd-directives.txt
ALLOW_LIST    = $(ALLOW_DIR)/systemd-directives.local.txt

# setuid root so xsup and group magaox can start and stop apps, and proclist editors (magaox-dev) can sync; xctrl
# drops to the caller at once and takes root back only to write its units and run systemctl
install: all
	sudo install -d $(BIN_PATH)
	sudo install $(TARGET) $(BIN_PATH) --mode=4755 --owner=root
	sudo ln -sf $(BIN_PATH)/$(TARGET) /usr/local/bin/$(TARGET)
	sudo install -d $(COMPLETIONS_DIR)
	sudo install -m 0644 xctrl.bash-completion $(COMPLETIONS_DIR)/$(TARGET)
	sudo install -m 0644 xctrl_completion.sh /etc/profile.d/xctrl_completion.sh
	@if [ -e $(ALLOW_DEFAULT) ] && ! cmp -s systemd-directives.txt $(ALLOW_DEFAULT); then \
	  echo "warning: the systemd-directives.txt installed differs from the $(ALLOW_DEFAULT) that was there;" \
	       "any site edits belong in $(ALLOW_LIST)"; \
	fi
	sudo install -d -o root -g root -m 0755 $(ALLOW_DIR)
	sudo install -o root -g root -m 0644 systemd-directives.txt $(ALLOW_DEFAULT)
	@if [ -e $(ALLOW_LIST) ]; then \
	  echo "$(ALLOW_LIST) exists, kept: xctrl reads it, so add or remove directives there"; \
	else \
	  sudo install -o root -g root -m 0644 systemd-directives.txt $(ALLOW_LIST) && \
	  echo "installed $(ALLOW_LIST), a copy of the defaults: xctrl reads it, so add or remove directives there"; \
	fi

.PHONY: clean
clean:
	rm -f $(TARGET) *.o
