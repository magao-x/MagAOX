# Makefile for xctrl, which needs the C++ standard library, flatlogs and the log headers generated by libMagAOX

SELF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
include $(SELF_DIR)/../../Make/common.mk

TARGET = xctrl

# xctrl writes MagAO-X binary logs: the text_log code and schema come from the libMagAOX build.  flatlogs includes
# mxlib headers, which need mxlib's flags (its include/mx directory and C++ standard) from pkg-config, as every app has
LOGGEN = ../../libMagAOX/logger/generated/logCodes.hpp ../../libMagAOX/logger/types/generated/string_log_generated.h

all: $(TARGET)

$(TARGET): xctrl.cpp xctrl.hpp xctrlLog.hpp ../../libMagAOX/common/paths.hpp ../../libMagAOX/common/defaults.hpp $(LOGGEN)
	$(CXX) $(MXLIB_CFLAGS) -O2 -Wall -Wextra $(INCLUDES) -o $@ xctrl.cpp

$(LOGGEN):
	@echo "xctrl needs $@: build libMagAOX first (make libs_all in the MagAOX directory)"; exit 1

# bash completion of commands, options, roles and apps: new shells load it from here the first time xctrl is completed
COMPLETIONS_DIR ?= /usr/share/bash-completion/completions

# setuid root so xsup and group magaox can start and stop apps; configuration changes still need sudo
install: all
	sudo install -d $(BIN_PATH)
	sudo install $(TARGET) $(BIN_PATH) --mode=4755 --owner=root
	sudo ln -sf $(BIN_PATH)/$(TARGET) /usr/local/bin/$(TARGET)
	sudo install -d $(COMPLETIONS_DIR)
	sudo install -m 0644 xctrl.bash-completion $(COMPLETIONS_DIR)/$(TARGET)

.PHONY: clean
clean:
	rm -f $(TARGET) *.o
