# WFS attachment / output-inhibition commissioning only. See ../EXAO2_TESTING.md.
# NOT a working live accelerometer-assisted training configuration.
# Use a freshly rebuilt DDSPC_SHADOW_ONLY=yes binary with a unique -n name.
# No native UINT16 ADC decoder, applied-command reader or exposure-time adapter exists yet.

[parameters]
shadow = true
shadow_min_updates = 0
gain = 0.3
copy_gain = 1.0
# Explicitly honor copy_gain. Default true preserves the historical loading bug in existing Legacy configs.
legacy_copy_gain_compat = false
regularization = 100.0
gamma = 1.0
covariance = 1e-5
history = 15
future = 3
num_modes = 2
fpsSource = camwfs
qrd = true
is_integrating = false
# Neither setting below enables output: the shadow-only build and shadow mode inhibit all frameGrabber use.
own_shmim = false
# Keep the incompatible legacy FLOAT sensor reader disabled for the UINT16 ADC stream.
accel_enabled = false
accel_channels = 2
accel_history = 5
accel_normalize = false

[shmimMonitor]
# Must be independently identified as the correct FLOAT modal residual, height1, width>=2; not the raw camera.
shmimName = REPLACE_WITH_VERIFIED_MODAL_WFS_STREAM
threadPrio = 0
cpuset =
getExistingFirst = false

# No framegrabber section or DM output stream. Do not add a DM channel or copy a production output name here.
# Future adapter requirements, not presently supported INI keys:
# ADC stream candidate: acc000; confirm on host, UINT16, channel order0/1, sample times and calibration.
# Applied-command source: UNVERIFIED; requests, calculated deltas and SDK acceptance are not applied readback.
# WFS exposure start/end, common clock mapping, uncertainty and physical response lag: UNVERIFIED.
