# DEVELOPMENT EXAMPLE ONLY: NOT A TELEMETRY QUALIFICATION OR DEPLOYMENT INSTRUCTION.
# See PHASE_DDSPC.md. Supply reviewed calibration, producer identity and counter anchors before training.
# Installed loPredCtrlAcc: continuous native inputs; compile-time DM output inhibition.
# Named application/INDI identity is supplied by xctrl: loPredCtrlAcc.
# Native training requires the upstream counter contract and complete calibrated command history.
loopPause = 100000000

[parameters]
shadow = true
shadow_pipeline = false
shadow_min_updates = 0
gain = 0.0
copy_gain = 1.0
# Explicitly honor copy_gain. Default true preserves the historical loading bug in existing Legacy configs.
legacy_copy_gain_compat = false
# Native standard and assisted use the same loPredCtrl-scaled command penalty and gain feedback.
regularization = 100.0
gamma = 1.0
covariance = 1e-5
history = 2
future = 2
num_modes = 2
fpsSource = camwfs
qrd = true
is_integrating = false
# Neither setting below enables output: the shadow-only build and shadow mode inhibit all frameGrabber use.
own_shmim = false
# Keep the incompatible legacy FLOAT sensor reader disabled for the UINT16 ADC stream.
accel_enabled = false
accel_channels = 2
accel_history = 1
accel_normalize = false

[shmimMonitor]
# Native observation bypasses this original WFS monitor; only the existing-only observer attaches inputs.
shmimName =
threadPrio = 0
cpuset =
getExistingFirst = false

# No framegrabber output section. The future [dm] auxiliary identity below is never opened in shadow mode.

# ADC health remains independent of model qualification. Calibration is unchanged.
[adc]
enabled = true
shmimName = acc000
profile = accelSim12
min_code = 0
max_code = 4095
reject_rails = true
zero0 = 2048
zero1 = 2048
volts_per_count0 = 0.0083799
volts_per_count1 = 0.0083799
sensitivity0 = 1.02
sensitivity1 = 1.02
polarity0 = 1
polarity1 = 1
capacity = 4096
max_age_us = 20000
max_interval_us = 1000
clock_tolerance_us = 1000

# The installed entrypoint enables native shadow acquisition by default.
[native_shadow]
enabled = true
# No journal directory or writer is opened in this default continuous mode.
record = false
duration_sec = 0
history_capacity = 4096
poll_us = 50
queue_capacity = 32768
# These select two entries, not a claim that the modal basis/calibration is tip/tilt.
modal_index0 = 0
modal_index1 = 1
modal_stream = aol1_modevalWFS
camera_stream = camwfs
# Observe the combined request, not just accelSim's dm01disp10 injection channel.
dm_stream = dm01disp
# Unknown preserves raw metadata and never subtracts unlike clocks. Declare only after source-build verification.
modal_acquisition_clock = unknown
modal_publication_clock = unknown
camera_acquisition_clock = unknown
camera_publication_clock = unknown
dm_acquisition_clock = unknown
dm_publication_clock = unknown
# Optional existing 16-word software endpoint streams. Empty means unavailable, never create/enable a producer.
completion_stream =
sdk_stream =
completion_acquisition_clock = unknown
completion_publication_clock = unknown
sdk_acquisition_clock = unknown
sdk_publication_clock = unknown

# Opt-in numerical worker; enabling it does not establish upstream lock, counter anchors or command provenance.
[online_shadow]
# Expect upstream semaphore/delay synchronization; this does not declare the producer synchronized.
upstream_sync = true
enabled = true
period_us = 1000
budget_us = 500
queue_capacity = 2048
adc_capacity = 4096
pending_capacity = 32
# Optional bounded scores. A nonempty exclusive private prediction_file enables the ordinary recorder thread.
prediction_capacity = 32768
prediction_file =
prediction_max_rows = 5000000
# Every real WFS target adapts at stride=1; larger strides explicitly reduce learning load. Gamma is per update.
training_stride = 1
# One preserves the single-rate command history; four selects a matched WFS-only lifted baseline.
standard_slots = 4

[diagnostics]
# Cap periodic INDI traffic independently of the 8 kHz input worker.
period_ms = 250
debug_indi = false

# Future producer identity only: no attachment, ownership lock, sidecars, semaphore or DM write in this build.
[dm]
channelName = dm10disp10_aux

[syncopation]
# Empty disables schedule observation. The actual helper is inherited but never polled/published in shadow.
timingStream = dmtweeter_synco_timing
writeLeadUs = 50

[native_inputs]
# Empty calibration intentionally inhibits native training. See SYNCO_NATIVE.md for the complete text format.
calibration =
# Actual acquisition producer's timingDiag subscription; a configured name is not synchronization evidence.
sync_device = accelSim
# AD7689: use sync_device=ad7689Ctrl and sync_property=ddspcTiming; keep reviewed reference/anchors.
sync_property = timingDiag
sync_reference = camwfs_sync
# Reviewed 4:1 source-incarnation anchors. Zero leaves assistance inhibited; standard can still train.
sync_epoch = 0
modal_anchor = 0
adc_anchor = 0
# Private plan-to-synco cycle association only; never an actuator eligibility or trust switch.
synco_association = false
synco_cycle_offset = 0
