# Offline numerical diagnostics only; no application, shared memory, INDI or device linkage.
APP_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
TEST_DIR := $(APP_DIR)/tests
BUILD_DIR ?= $(APP_DIR)/build/stability
PROGRAM ?= rls_diagnostics
CXX = c++
CPPFLAGS += $(shell pkg-config --cflags-only-I eigen3 mxlib) -DEIGEN_DONT_PARALLELIZE
CXXFLAGS ?= -O3 -g -std=c++20 -Wall -Wextra -fno-fast-math
SOURCES := $(TEST_DIR)/$(PROGRAM).cpp $(APP_DIR)/ar_controller.cpp $(APP_DIR)/recursive_least_squares.cpp \
           $(APP_DIR)/qrd_rls.cpp $(APP_DIR)/utils.cpp
OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(SOURCES:.cpp=.o)))
VPATH := $(sort $(dir $(SOURCES)))
TARGET := $(BUILD_DIR)/$(PROGRAM)
.PHONY: all
all: $(TARGET)
$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $^ -o $@
$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
-include $(OBJECTS:.o=.d)
