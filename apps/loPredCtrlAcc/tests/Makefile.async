# Experimental offline threads only: no native application, device library, INDI or ImageStreamIO.
APP_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
TEST_DIR := $(APP_DIR)/tests
BUILD_DIR ?= $(APP_DIR)/build/async
CXX = c++
CPPFLAGS += $(shell pkg-config --cflags-only-I eigen3 mxlib) -DEIGEN_DONT_PARALLELIZE \
            -DDDSPC_OFFLINE_ALLOCATION_PROBE -pthread -include $(TEST_DIR)/allocation_probe.hpp
CXXFLAGS ?= -O3 -g
CXXFLAGS += -std=c++20 -Wall -Wextra -fno-fast-math
LDLIBS += -pthread
SOURCES := $(TEST_DIR)/async_benchmark.cpp $(TEST_DIR)/async_shadow.cpp $(TEST_DIR)/allocation_new.cpp \
           $(APP_DIR)/ar_controller.cpp $(APP_DIR)/recursive_least_squares.cpp $(APP_DIR)/qrd_rls.cpp \
           $(APP_DIR)/utils.cpp $(APP_DIR)/shadow_controller.cpp
OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(SOURCES:.cpp=.o)))
VPATH := $(sort $(dir $(SOURCES)))
TARGET := $(BUILD_DIR)/ddspc_async_benchmark
.PHONY: all check
all: $(TARGET)
check: $(TARGET)
	$(TARGET) 2000
$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $^ $(LDLIBS) -o $@
$(BUILD_DIR)/%.o: %.cpp $(TEST_DIR)/allocation_probe.hpp
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@
-include $(OBJECTS:.o=.d)
