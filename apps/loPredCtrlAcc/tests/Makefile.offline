# Standalone numerical/application tests with real INDI properties and stream-free lifecycle doubles.
# No native MagAOX application, ImageStreamIO, driver, or hardware library is linked.
# adc_reader.cpp uses the explicit private API double in native_stubs, never runtime shared memory.
# Run from apps/loPredCtrlAcc: make -f tests/Makefile.offline check
APP_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
.DEFAULT_GOAL := all
TEST_DIR := $(APP_DIR)/tests
ROOT_DIR := $(abspath $(APP_DIR)/../..)
BUILD_DIR ?= $(APP_DIR)/build/offline
CXX = c++
DEPENDENCY_INCLUDES := $(shell pkg-config --cflags-only-I eigen3 mxlib)
CPPFLAGS += -I$(TEST_DIR)/native_stubs $(DEPENDENCY_INCLUDES) -DEIGEN_DONT_PARALLELIZE
CPPFLAGS += -include $(TEST_DIR)/legacy_platform.hpp
CXXFLAGS ?= -O2 -g
CXXFLAGS += -std=c++20 -Wall -Wextra -fno-fast-math
SOURCES := $(ROOT_DIR)/tests/testMain.cpp $(APP_DIR)/ar_controller.cpp \
           $(APP_DIR)/recursive_least_squares.cpp $(APP_DIR)/qrd_rls.cpp $(APP_DIR)/utils.cpp \
           $(APP_DIR)/adc_features.cpp $(APP_DIR)/shadow_policy.cpp $(APP_DIR)/shadow_pipeline.cpp $(APP_DIR)/shadow_controller.cpp $(APP_DIR)/causal_input.cpp $(APP_DIR)/adc_input.cpp $(APP_DIR)/adc_reader.cpp $(APP_DIR)/native_observation.cpp $(APP_DIR)/native_observer.cpp $(TEST_DIR)/adc_transport_fixture.cpp \
           $(TEST_DIR)/shadow_replay.cpp $(TEST_DIR)/offline_adc.cpp $(TEST_DIR)/offline_control.cpp $(TEST_DIR)/offline_ddspc.cpp \
           $(TEST_DIR)/comparison.cpp $(TEST_DIR)/vibration.cpp $(TEST_DIR)/stability.cpp \
           $(TEST_DIR)/phase6_adapter.cpp $(TEST_DIR)/operational_law.cpp \
           $(TEST_DIR)/phase7_adapter.cpp $(TEST_DIR)/async_shadow.cpp \
           $(ROOT_DIR)/INDI/libcommon/IndiProperty.cpp $(ROOT_DIR)/INDI/libcommon/IndiElement.cpp \
           $(ROOT_DIR)/INDI/libcommon/TimeStamp.cpp \
           $(wildcard $(TEST_DIR)/ddspc_*_test.cpp)
OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(SOURCES:.cpp=.o)))
ifneq ($(filter $(TEST_DIR)/vibration.cpp,$(SOURCES)),)
include $(TEST_DIR)/Makefile.stability-model
endif
VPATH := $(sort $(dir $(SOURCES)))
TARGET := $(BUILD_DIR)/ddspc_offline_test
LEGACY_ROOT := $(abspath $(BUILD_DIR))/historical
LEGACY_STAMP := $(LEGACY_ROOT)/snapshot.stamp
LEGACY_NAMES := ar_controller recursive_least_squares qrd_rls utils
LEGACY_OBJECTS := $(addprefix $(BUILD_DIR)/original_,$(addsuffix .o,$(LEGACY_NAMES))) \
                  $(addprefix $(BUILD_DIR)/restored_,$(addsuffix .o,$(LEGACY_NAMES)))
ADAPTER_SOURCES := $(wildcard $(TEST_DIR)/legacy_*_adapter.cpp)
OBJECTS += $(addprefix $(BUILD_DIR)/,$(notdir $(ADAPTER_SOURCES:.cpp=.o))) $(LEGACY_OBJECTS)
VPATH += $(TEST_DIR)
CPPFLAGS += -I$(LEGACY_ROOT)
PHASE6_ROOT := $(abspath $(BUILD_DIR))/phase6
PHASE6_STAMP := $(PHASE6_ROOT)/snapshot.stamp
PHASE6_NAMES := ar_controller recursive_least_squares qrd_rls utils shadow_controller
PHASE6_OBJECTS := $(addprefix $(BUILD_DIR)/phase6_,$(addsuffix .o,$(PHASE6_NAMES)))
OBJECTS += $(PHASE6_OBJECTS)
CPPFLAGS += -I$(abspath $(BUILD_DIR))
LDLIBS += -pthread
# Keep historical numerical-object flags while compiling the new POSIX thread users with their required flag.
$(BUILD_DIR)/async_shadow.o $(BUILD_DIR)/ddspc_async_test.o: CPPFLAGS += -pthread
PHASE7_ROOT := $(abspath $(BUILD_DIR))/phase7
PHASE7_STAMP := $(PHASE7_ROOT)/snapshot.stamp
PHASE7_OBJECTS := $(addprefix $(BUILD_DIR)/phase7_,$(addsuffix .o,$(PHASE6_NAMES)))
OBJECTS += $(PHASE7_OBJECTS)
PHASE8_ROOT := $(abspath $(BUILD_DIR))/phase8
PHASE8_STAMP := $(PHASE8_ROOT)/snapshot.stamp
PHASE8_OBJECTS := $(addprefix $(BUILD_DIR)/phase8_,$(addsuffix .o,$(PHASE6_NAMES)))
OBJECTS += $(PHASE8_OBJECTS) $(BUILD_DIR)/phase8_async_shadow.o

# The dedicated offline safety build needs only its explicit app sources, not historical replay oracles.
ifeq ($(DDSPC_MINIMAL_APP_TESTS),yes)
OBJECTS := $(addprefix $(BUILD_DIR)/,$(notdir $(SOURCES:.cpp=.o)))
endif

$(PHASE8_STAMP): $(TEST_DIR)/prepare_phase8.py $(TEST_DIR)/prepare_phase6.py
	python3 $(TEST_DIR)/prepare_phase8.py --output $(PHASE8_ROOT)

$(BUILD_DIR)/ddspc_phase9_test.o: $(PHASE8_STAMP)

$(PHASE8_OBJECTS): $(BUILD_DIR)/phase8_%.o: $(PHASE8_STAMP)
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DDDSPC=DDSPCPhase8 -MMD -MP -c $(PHASE8_ROOT)/$*.cpp -o $@

$(BUILD_DIR)/phase8_async_shadow.o: $(PHASE8_STAMP)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -pthread -DDDSPC=DDSPCPhase8 -MMD -MP -c $(PHASE8_ROOT)/tests/async_shadow.cpp -o $@

$(PHASE7_STAMP): $(TEST_DIR)/prepare_phase7.py $(TEST_DIR)/prepare_phase6.py
	python3 $(TEST_DIR)/prepare_phase7.py --output $(PHASE7_ROOT)

$(BUILD_DIR)/phase7_adapter.o: $(PHASE7_STAMP)

$(PHASE7_OBJECTS): $(BUILD_DIR)/phase7_%.o: $(PHASE7_STAMP)
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DDDSPC=DDSPCPhase7 -MMD -MP -c $(PHASE7_ROOT)/$*.cpp -o $@

$(PHASE6_STAMP): $(TEST_DIR)/prepare_phase6.py
	python3 $(TEST_DIR)/prepare_phase6.py --output $(PHASE6_ROOT)

$(BUILD_DIR)/phase6_adapter.o: $(PHASE6_STAMP)

$(PHASE6_OBJECTS): $(BUILD_DIR)/phase6_%.o: $(PHASE6_STAMP)
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DDDSPC=DDSPCPhase6 -MMD -MP -c $(PHASE6_ROOT)/$*.cpp -o $@

.PHONY: all check check-shadow-only check-build-tool verify-legacy check-legacy-fast check-demos
all: $(TARGET)

check: check-build-tool verify-legacy $(TARGET)
	$(TARGET) --durations yes

# Exercise the real header with the commissioning guard compiled into every translation unit.
# This separate binary uses the same stream-free lifecycle doubles; it is never a native app launch.
SHADOW_TEST_SOURCES := $(ROOT_DIR)/tests/testMain.cpp $(APP_DIR)/ar_controller.cpp \
                      $(APP_DIR)/recursive_least_squares.cpp $(APP_DIR)/qrd_rls.cpp $(APP_DIR)/utils.cpp \
                      $(APP_DIR)/adc_features.cpp $(APP_DIR)/shadow_policy.cpp $(APP_DIR)/shadow_pipeline.cpp $(APP_DIR)/shadow_controller.cpp $(APP_DIR)/causal_input.cpp $(APP_DIR)/adc_input.cpp $(APP_DIR)/adc_reader.cpp $(APP_DIR)/native_observation.cpp $(APP_DIR)/native_observer.cpp $(TEST_DIR)/adc_transport_fixture.cpp \
                      $(ROOT_DIR)/INDI/libcommon/IndiProperty.cpp $(ROOT_DIR)/INDI/libcommon/IndiElement.cpp \
                      $(ROOT_DIR)/INDI/libcommon/TimeStamp.cpp $(TEST_DIR)/ddspc_app_test.cpp $(TEST_DIR)/ddspc_shadow_pipeline_test.cpp $(TEST_DIR)/shadow_replay.cpp $(TEST_DIR)/offline_adc.cpp
check-shadow-only:
	$(MAKE) -f $(TEST_DIR)/Makefile.offline BUILD_DIR=$(abspath $(BUILD_DIR))/shadow-only CXX=$(CXX) \
	  CXXFLAGS='$(CXXFLAGS) -DDDSPC_SHADOW_ONLY' SOURCES='$(SHADOW_TEST_SOURCES)' \
	  $(abspath $(BUILD_DIR))/shadow-only/ddspc_offline_test
	$(abspath $(BUILD_DIR))/shadow-only/ddspc_offline_test '[loPredCtrlAcc][app]~[legacy]'

# Optional passive replay includes only the simulator's platform-independent numerical header, read-only.
# No accelSim executable, native stream, output helper or acquisition hardware is linked or started.
MAGAOX_REPO ?= $(abspath $(ROOT_DIR)/../MagAOX)
.PHONY: check-confirmed-replay
check-confirmed-replay:
	@test -f '$(MAGAOX_REPO)/apps/accelSim/accelSimModel.hpp'
	$(MAKE) -f $(TEST_DIR)/Makefile.offline BUILD_DIR=$(abspath $(BUILD_DIR))/confirmed-replay CXX=$(CXX) \
	  DDSPC_MINIMAL_APP_TESTS=yes \
	  CXXFLAGS='$(CXXFLAGS) -DDDSPC_SHADOW_ONLY -I$(MAGAOX_REPO)/apps/accelSim' \
	  SOURCES='$(SHADOW_TEST_SOURCES) $(TEST_DIR)/adc_forwarder.cpp $(TEST_DIR)/confirmed_replay.cpp $(TEST_DIR)/confirmed_replay_test.cpp' \
	  $(abspath $(BUILD_DIR))/confirmed-replay/ddspc_offline_test
	$(abspath $(BUILD_DIR))/confirmed-replay/ddspc_offline_test '[confirmed-replay]'

.PHONY: check-native-observation
check-native-observation:
	$(MAKE) -f $(TEST_DIR)/Makefile.offline BUILD_DIR=$(abspath $(BUILD_DIR))/native-observation CXX=$(CXX) \
	  DDSPC_MINIMAL_APP_TESTS=yes CXXFLAGS='$(CXXFLAGS) -DDDSPC_SHADOW_ONLY' \
	  SOURCES='$(SHADOW_TEST_SOURCES) $(TEST_DIR)/ddspc_native_observation_test.cpp $(TEST_DIR)/native_observation_app_test.cpp' \
	  $(abspath $(BUILD_DIR))/native-observation/ddspc_offline_test
	$(abspath $(BUILD_DIR))/native-observation/ddspc_offline_test '[native-observation],[loPredCtrlAcc][app]~[legacy]'
	python3 -m unittest discover -s $(TEST_DIR) -p native_observation_tools_test.py

check-build-tool:
	python3 -m unittest discover -s $(TEST_DIR) -p native_linux_build_test.py

verify-legacy:
	python3 $(TEST_DIR)/prepare_legacy.py

$(LEGACY_STAMP): $(TEST_DIR)/prepare_legacy.py
	python3 $(TEST_DIR)/prepare_legacy.py --output $(LEGACY_ROOT)

$(BUILD_DIR)/legacy_original_adapter.o $(BUILD_DIR)/legacy_restored_adapter.o: $(LEGACY_STAMP)

$(addprefix $(BUILD_DIR)/original_,$(addsuffix .o,$(LEGACY_NAMES))): $(BUILD_DIR)/original_%.o: $(LEGACY_STAMP)
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DDDSPC=DDSPCOriginal -MMD -MP -c $(LEGACY_ROOT)/original/apps/loPredCtrl/$*.cpp -o $@

$(addprefix $(BUILD_DIR)/restored_,$(addsuffix .o,$(LEGACY_NAMES))): $(BUILD_DIR)/restored_%.o: $(LEGACY_STAMP)
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DDDSPC=DDSPCRestored -MMD -MP -c $(ROOT_DIR)/apps/loPredCtrl/$*.cpp -o $@

# Match native legacy fast-math flags without running strict causal/nonfinite-input suites under those flags.
LEGACY_FAST_FLAGS ?= -O3 -g -std=c++20 -Wall -Wextra -ffast-math
check-legacy-fast:
	$(MAKE) -f $(TEST_DIR)/Makefile.offline BUILD_DIR=$(abspath $(BUILD_DIR))/legacy-fast \
	  CXXFLAGS='$(LEGACY_FAST_FLAGS)' \
	  SOURCES='$(ROOT_DIR)/tests/testMain.cpp $(APP_DIR)/ar_controller.cpp $(APP_DIR)/recursive_least_squares.cpp $(APP_DIR)/qrd_rls.cpp $(APP_DIR)/utils.cpp $(APP_DIR)/adc_features.cpp $(APP_DIR)/shadow_policy.cpp $(APP_DIR)/shadow_pipeline.cpp $(APP_DIR)/shadow_controller.cpp $(APP_DIR)/causal_input.cpp $(APP_DIR)/adc_input.cpp $(APP_DIR)/adc_reader.cpp $(APP_DIR)/native_observation.cpp $(APP_DIR)/native_observer.cpp $(TEST_DIR)/adc_transport_fixture.cpp $(ROOT_DIR)/INDI/libcommon/IndiProperty.cpp $(ROOT_DIR)/INDI/libcommon/IndiElement.cpp $(ROOT_DIR)/INDI/libcommon/TimeStamp.cpp $(TEST_DIR)/ddspc_legacy_test.cpp $(TEST_DIR)/ddspc_qr_compatibility_test.cpp' check

# Historical demonstration programs contain no assertions; run them as separate, explicitly labeled smoke checks.
DEMO_NAMES ?= testRLS testPredCtrl
DEMO_ORIGINAL := $(addprefix $(BUILD_DIR)/demo_original_,$(DEMO_NAMES))
DEMO_CURRENT := $(addprefix $(BUILD_DIR)/demo_current_,$(DEMO_NAMES))
check-demos: verify-legacy $(DEMO_ORIGINAL) $(DEMO_CURRENT)
	python3 $(TEST_DIR)/prepare_legacy.py --demo-dir $(abspath $(BUILD_DIR)) $(addprefix --demo-name ,$(DEMO_NAMES))

$(DEMO_ORIGINAL): $(BUILD_DIR)/demo_original_%: $(LEGACY_STAMP) $(filter $(BUILD_DIR)/original_%,$(LEGACY_OBJECTS))
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -DDDSPC=DDSPCOriginal $(LEGACY_ROOT)/original/apps/loPredCtrl/$*.cpp $(filter %.o,$^) $(LDFLAGS) $(LDLIBS) -o $@

$(DEMO_CURRENT): $(BUILD_DIR)/demo_current_%: $(BUILD_DIR)/ar_controller.o $(BUILD_DIR)/recursive_least_squares.o $(BUILD_DIR)/qrd_rls.o $(BUILD_DIR)/utils.o
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(APP_DIR)/$*.cpp $^ $(LDFLAGS) $(LDLIBS) -o $@

$(TARGET): $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $^ $(LDLIBS) -o $@

# Bundled INDI still uses std::ptr_fun/std::not1; compile that unchanged source in its original dialect.
$(BUILD_DIR)/IndiProperty.o: $(ROOT_DIR)/INDI/libcommon/IndiProperty.cpp
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(filter-out -std=c++20,$(CXXFLAGS)) -std=c++14 -MMD -MP -c $< -o $@

$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(OBJECTS:.o=.d)

# Focused capture/actual-worker tests use an offline ImageStreamIO API double and private ordinary files only.
.PHONY: check-adc
check-adc:
	@mkdir -p $(BUILD_DIR)
	$(CXX) -I$(TEST_DIR)/native_stubs $(DEPENDENCY_INCLUDES) $(CXXFLAGS) \
	  $(ROOT_DIR)/tests/testMain.cpp $(APP_DIR)/adc_input.cpp $(APP_DIR)/adc_reader.cpp \
	  $(TEST_DIR)/adc_transport_fixture.cpp $(TEST_DIR)/ddspc_adc_test.cpp \
	  $(TEST_DIR)/ddspc_adc_transport_test.cpp $(TEST_DIR)/offline_adc.cpp $(TEST_DIR)/ddspc_adc_synthetic_test.cpp \
	  $(LDFLAGS) -pthread -o $(BUILD_DIR)/ddspc_adc_test
	$(BUILD_DIR)/ddspc_adc_test '[adc]'
