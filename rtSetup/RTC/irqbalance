############################################
# \file
# \brief Keep ordinary IRQ balancing off the RTC dedicated cores and their SMT siblings.
#
# Match IRQBALANCE_BANNED_CPULIST to the dedicated CPUs and offline siblings in make_cpusets.
#
# Edit the irqbalance_policyscript to include IRQs to ban
#
# To Install:
#
# If first time after new installation: $ cp /etc/sysconfig/irqbalance /etc/sysconfig/irqbalance.bup
#
# $ systemctl stop irqbalance
#
# Then start irqbalance:
# $ systemctl start irqbalance
# $ systemctl status irqbalance
#

# irqbalance is a daemon process that distributes interrupts across
# CPUS on SMP systems. The default is to rebalance once every 10
# seconds. This is the environment file that is specified to systemd via the
# EnvironmentFile key in the service unit file (or via whatever method the init
# system you're using has.
#
# ONESHOT=yes
# after starting, wait for a minute, then look at the interrupt
# load and balance it once; after balancing exit and do not change
# it again.
#IRQBALANCE_ONESHOT=

#
# IRQBALANCE_BANNED_CPULIST
# CPU list excluded from ordinary IRQ balancing. Device-specific routing
# remains in move_irqs, with selected IRQs protected by irqbalance_policyscript.
#
# Dedicated physical cores 30-63 and their offline SMT siblings 94-127.
IRQBALANCE_BANNED_CPULIST=30-63,94-127

#
# IRQBALANCE_ARGS
# append any args here to the irqbalance daemon as documented in the man page
#
# Banning IDs by matching in the scripts
IRQBALANCE_ARGS=--policyscript=/usr/local/bin/irqbalance_policyscript
