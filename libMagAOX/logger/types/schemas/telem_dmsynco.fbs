/// \file telem_dmsynco.fbs
/// \brief Scheduler telemetry with optional primary cadence and combiner trace measurements.
namespace MagAOX.logger;

// Values and coverage are seconds; publication values retain their external clock.
table DmSyncoTimingStats
{
    count:ulong;
    mean:double;
    stddev:double;
    min:double;
    max:double;
    span:double;
    valid:bool;
}

table DmSyncoPrimaryTiming
{
    session:ulong;
    sequence:ulong;
    now_ns:long;
    window_sec:double;
    span_sec:double;
    age_sec:double;
    capacity:ulong;
    queued:ulong;
    enabled:bool;
    valid:bool;
    publication:DmSyncoTimingStats (required);
    receipt:DmSyncoTimingStats (required);
    events:ulong;
    receipts:ulong;
    synthetic:ulong;
    rejected:ulong;
    duplicates:ulong;
    counter_gaps:ulong;
    invalid:ulong;
    dropped:ulong;
}

table DmSyncoCombinerTiming
{
    session:ulong;
    sequence:ulong;
    now_ns:long;
    window_sec:double;
    span_sec:double;
    age_sec:double;
    capacity:ulong;
    queued:ulong;
    enabled:bool;
    writer_pid:long;
    trigger_inode:ulong;
    primary_counter:ulong;
    publication_interval:DmSyncoTimingStats (required);
    receipt_interval:DmSyncoTimingStats (required);
    execution:DmSyncoTimingStats (required);
    publication:DmSyncoTimingStats (required);
    primary_start:DmSyncoTimingStats (required);
    primary_publication:DmSyncoTimingStats (required);
    events:ulong;
    receipts:ulong;
    synthetic:ulong;
    rejected:ulong;
    duplicates:ulong;
    counter_gaps:ulong;
    invalid_metadata:ulong;
    missing_trace:ulong;
    invalid_trace:ulong;
    repeated_start:ulong;
    unlinked_primary:ulong;
    invalid_primary:ulong;
    repeated_primary:ulong;
    dropped:ulong;
}

table Telem_dmsynco_fb
{
    state:int;
    steps:int;
    period_ns:long;
    delivered:ulong;
    missed:ulong;
    faults:ulong;
    cached:ulong;
    snapshot_ns:long;
    copy_ns:long;
    residuals_ns:[long];
    advances_ns:[long];
    primary_timing:DmSyncoPrimaryTiming;
    schedule_valid:bool = true;
    combiner_timing:DmSyncoCombinerTiming;
}

root_type Telem_dmsynco_fb;
