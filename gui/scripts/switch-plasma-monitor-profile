#!/usr/bin/env bash

##################################################################
# A script to switch AOC between 6 monitor and 4 monitor setups
#
# Usage: switch-plasma-monitor-profile {4mon|6mon|save-4mon|save-6mon}
#
#        The options are:
#          save-6mon: save the current profile as the 6 monitor setup
#          save-4mon: save the current profile as the 4 monitor setup
#          6mon: switch to the 6 monitor setup
#          4mon: switch to the 4 monitor setup
#
# You will probably need to run this with plasma not running.  Something like:
#   sudo systemctl isolate multi-user.target
#   sudo systemctl stop sddm
#   switch-plasma-monitor-profile {4mon|6mon}
#   sudo systemctl start sddm
#
# This is poorly tested as of 2026-05-27
#
# Script generated by ChatGPT 5

set -euo pipefail

CONFIG_FILES=(
    kscreenlockerrc
    kwinrc
    kwinrulesrc
    plasmashellrc
    plasma-org.kde.plasma.desktop-appletsrc
)

LOCAL_SHARE_DIRS=(
    kscreen
)

usage() {
    echo "Usage: $0 {4mon|6mon|save-4mon|save-6mon}"
    exit 1
}

profile="${1:-}"
[[ -n "$profile" ]] || usage

CONFIG="$HOME/.config"
LOCAL="$HOME/.local/share"

profiles="$HOME/.plasma-monitor-profiles"
mkdir -p "$profiles"/{4mon,6mon}

copy_into_profile() {
    local p="$1"

    mkdir -p \
        "$profiles/$p/config" \
        "$profiles/$p/local-share"

    for f in "${CONFIG_FILES[@]}"; do
        cp -a \
            "$CONFIG/$f" \
            "$profiles/$p/config/" \
            2>/dev/null || true
    done

    for d in "${LOCAL_SHARE_DIRS[@]}"; do
        cp -a \
            "$LOCAL/$d" \
            "$profiles/$p/local-share/" \
            2>/dev/null || true
    done
}

install_profile() {
    local p="$1"

    echo "Switching to Plasma monitor profile: $p"

    mkdir -p "$HOME/.plasma-monitor-backups"

    backup="$HOME/.plasma-monitor-backups/$(date +%Y%m%d-%H%M%S)-before-$p"

    mkdir -p \
        "$backup/config" \
        "$backup/local-share"

    for f in "${CONFIG_FILES[@]}"; do

        if [[ -e "$CONFIG/$f" || -L "$CONFIG/$f" ]]; then
            mv "$CONFIG/$f" "$backup/config/"
        fi

        if [[ -e "$profiles/$p/config/$f" ]]; then
            ln -s \
                "$profiles/$p/config/$f" \
                "$CONFIG/$f"
        fi
    done

    for d in "${LOCAL_SHARE_DIRS[@]}"; do

        if [[ -e "$LOCAL/$d" || -L "$LOCAL/$d" ]]; then
            mv "$LOCAL/$d" "$backup/local-share/"
        fi

        if [[ -e "$profiles/$p/local-share/$d" ]]; then
            ln -s \
                "$profiles/$p/local-share/$d" \
                "$LOCAL/$d"
        fi
    done

    echo "Done. Log out/in or restart Plasma/KWin."
}

case "$profile" in
    save-4mon)
        copy_into_profile 4mon
        ;;
    save-6mon)
        copy_into_profile 6mon
        ;;
    4mon)
        install_profile 4mon
        ;;
    6mon)
        install_profile 6mon
        ;;
    *)
        usage
        ;;
esac
