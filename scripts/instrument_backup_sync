#!/usr/bin/env bash
set -x
if [[ $EUID != 0 ]]; then
    echo "Must be run as root (sudo)"
    exit 1
fi
if [[ $(hostname) != "exao1" ]]; then
    echo "Must run on exao1"
    exit 1
fi
if [[ -z "$1" ]]; then
    dest=/mnt/backup
else
    dest="$1"
fi
if [[ $dest == /mnt/backup ]]; then
    if ! mount | grep -q "on /mnt/backup"; then
        echo "External drive mount appears not to be active for /mnt/backup"
        exit 1
    fi
fi

logOutputPath=/tmp/instrument_backup_sync_$(date +%s).log

echo > $logOutputPath
writeLog() {
    logStr="$(date +"%Y-%m-%dT%H:%M:%SZ") $1"
    echo $logStr | tee -a $logOutputPath
}
exitWithError() {
    writeLog "$1"
    exit 1
}
remindPath() {
    echo "Log in $logOutputPath"
}
remindPath
trap remindPath EXIT


declare -a dataFolders=("opt/MagAOX/rawimages" "opt/MagAOX/telem" "opt/MagAOX/cacao" "opt/MagAOX/logs" "opt/MagAOX/calib")
sourceFolders=()
destFolders=()

for remote in icc rtc; do
    for folder in "${dataFolders[@]}"; do
        if ! mount | grep -q "on /srv/$remote/$folder"; then
            echo "NFS mount appears not to be active on /srv/$remote/$folder"
            exit 1
        else
            sourceFolders+=("/srv/$remote/$folder/")
            destFolders+=("$dest/$remote/$folder/")
        fi
    done
done

for folder in "${dataFolders[@]}"; do
    sourceFolders+=("/$folder/")
    destFolders+=("$dest/aoc/$folder/")
done

for homeDir in /home/*; do
	homeName="$(basename $homeDir)"
	if [[ "$homeName" == "data" || "$homeName" == "guestobs" ]]; then continue; fi
        sourceFolders+=("/home/$homeName/")
        destFolders+=("$dest/aoc/home/$homeName/")
done

rsyncWithOptions="rsync -rt --info=progress2 --info=name0 $extraRsyncOptions"

writeLog "Syncing:"

for index in "${!sourceFolders[@]}"; do
    srcPath="${sourceFolders[$index]}"
    destPath="${destFolders[$index]}"
    writeLog "$srcPath -> $destPath"
done

failedFolders=()

for index in "${!sourceFolders[@]}"; do
    srcPath="${sourceFolders[$index]}"
    destPath="${destFolders[$index]}"
    mkdir -p "$destPath"
    cmd="$rsyncWithOptions $srcPath $destPath"
    writeLog "Start: $cmd"
    $cmd 2>&1 | tee -a "$logOutputPath"
    rc=${PIPESTATUS[0]}
    if [[ $rc == 24 ]]; then
        writeLog "Warning, files vanished during transfer from $srcPath"
        writeLog "Finished: [exit: $rc] $cmd"
    elif [[ $rc != 0 ]]; then
        failedFolders+=("$srcPath")
        writeLog "Failed: [exit: $rc] $cmd"
    else
        writeLog "Success: $cmd"
    fi
done

if [[ ${#failedFolders[@]} != 0 ]]; then
    exitWithError "Failed to rsync: ${failedFolders[*]}"
fi
