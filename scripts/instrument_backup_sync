#!/usr/bin/env bash
set -ex
# If not started as root, sudo yourself
if [[ "$EUID" != 0 ]]; then
    sudo -H bash -l $0 "$@"
    exit $?
fi
if [[ $(hostname) != "exao1" ]]; then
    echo "Must run on exao1"
    exit 1
fi
if [[ -z "$1" ]]; then
    dest=/mnt/backup
else
    dest="$1"
fi

if ! mount | grep -q "on $dest"; then
    echo "External drive mount appears not to be active for $dest"
    exit 1
fi
for remote in icc rtc; do
    for folder in data calib; do
        if ! mount | grep -q "on /srv/$remote/$folder"; then
            echo "NFS mount appears not to be active for on /srv/$remote/$folder"
            exit 1
        fi
    done
done

rsyncWithOptions="rsync --exclude=obs --exclude='*_2022*' --exclude='.Trash*' --exclude='*_2023*' --exclude='*_2024*' -a --info=progress2"

mkdir -p $dest/rtc/
$rsyncWithOptions /srv/rtc/data/ $dest/rtc/
$rsyncWithOptions /srv/rtc/calib/ $dest/rtc/calib/

mkdir -p $dest/icc/
$rsyncWithOptions /srv/icc/data/ $dest/icc/
$rsyncWithOptions /srv/icc/calib/ $dest/icc/calib/

mkdir -p $dest/aoc/
$rsyncWithOptions /data/ $dest/aoc/


