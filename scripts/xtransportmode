#!/bin/bash

echo "setting transport mode"

setINDI "stagepickoff.presetName.lab=Off;none=Off;tel=On"
setINDI "adctrack.tracking.toggle=Off"
setINDI "ktrack.tracking.toggle=Off"
sleep 2
setINDI "stagek.presetName.gmt=Off;lab=Off;none=Off;transport=On"
setINDI "stagepollin.presetName.in=Off;out=Off;shutter=Off;transport=On"
setINDI "fwsci1.filterName.CH4-875=On,Ha-Cont=Off;i=Off;open=Off;r=Off;z=Off"
setINDI "fwsci2.filterName.Ha-narrow=On;Halpha=Off;g=Off;i=Off;r=Off;z=Off"

xlog "ran xtransportmode"
