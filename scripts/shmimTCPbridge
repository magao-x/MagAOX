#!/bin/bash
set -eo pipefail

#######################################################
# shmimTCPbridge: generic shmimTCP stream bridge
#
# gets a stream from a remote computer and puts it on
# this computer or takes a stream from this computer 
# and sends it to a remote.
#######################################################

pname=$(basename "$0")

function printHELP {
echo "------------------------------------------------------------------------"
echo " $pname : bridge a shmim stream from a remote host to this machine"
echo " or from this machine to a remote host"
echo "------------------------------------------------------------------------"
echo "USAGE:"
echo "  $pname <stream_name> <remote_host> <receiver_ip> <port> [mode]"
echo "  [mode]        : pull (default) or push"
echo ""
echo "MODES:"
echo "  pull : REMOTE -> LOCAL"
echo "  push : LOCAL  -> REMOTE"
echo ""
echo "INPUT:"
echo "  <stream_name> : shmim name on remote machine"
echo "  <remote_host> : user@host of sender (e.g. parker@192.168.21.5)"
echo "  <receiver_ip> : IP of machine running shmimTCPreceive"
echo "  <port>        : TCP port to use"
echo ""
echo "EXAMPLE:"
echo "  $pname acc000 parker@192.168.21.5 192.168.21.3 8886 pull"
echo "  $pname camwfs_sync parker@192.168.21.5 192.168.21.5 8886 push"
echo "------------------------------------------------------------------------"
}

# check args
if [ $# -lt 4 ]; then
    printHELP
    exit 1
fi

STREAM=$1
REMOTE=$2
RECEIVER_IP=$3
PORT=$4
MODE=${5:-pull}
if [[ "$MODE" != "pull" && "$MODE" != "push" ]]; then
    echo "Error: mode must be 'pull' or 'push'"
    exit 1
fi

ME=$(hostname)

# tmux session names
RX_SESSION="sTCPrc-${ME}-${PORT}"
TX_SESSION="sTCPtx-${PORT}"

if [ "$MODE" = "pull" ]; then
    # Start receiver locally
    echo "Starting receiver on $(hostname) (port ${PORT})"

    tmux new -d -s ${RX_SESSION} || true
    tmux send -t ${RX_SESSION} C-c C-m "shmimTCPreceive ${PORT}" C-m

    # Start transmitter on remote machine
    echo "Starting transmitter on ${REMOTE}"

    ssh -t ${REMOTE} "tmux new -d -s ${TX_SESSION}" || true

    # explicitly identify path
    ssh -t ${REMOTE} \
    "tmux send -t ${TX_SESSION} C-c C-m 'export PATH=/usr/local/milk/bin:/usr/local/bin:\$PATH; shmimTCPtransmit ${STREAM} ${RECEIVER_IP} ${PORT}' C-m"

    echo ""
    echo "Bridge established:"
    echo "  Stream      : ${STREAM}"
    echo "  From        : ${REMOTE}"
    echo "  To (local)  : ${RECEIVER_IP}:${PORT}"
fi

if [ "$MODE" = "push" ]; then

    # Start receiver on remote machine
    echo "Starting receiver on ${REMOTE} (port ${PORT})"

    ssh -t ${REMOTE} "tmux new -d -s ${RX_SESSION}" || true

    ssh -t ${REMOTE} \
    "tmux send -t ${RX_SESSION} C-c C-m 'export PATH=/usr/local/milk/bin:/usr/local/bin:\$PATH; shmimTCPreceive ${PORT}' C-m"

    # Start transmitter locally
    echo "Starting transmitter on $(hostname)"

    tmux new -d -s ${TX_SESSION} || true
    tmux send -t ${TX_SESSION} C-c C-m \
    "export PATH=/usr/local/milk/bin:/usr/local/bin:\$PATH; shmimTCPtransmit ${STREAM} ${RECEIVER_IP} ${PORT}" C-m

    echo ""
    echo "Bridge established:"
    echo "  Stream : ${STREAM}"
    echo "  From   : $(hostname)"
    echo "  To     : ${RECEIVER_IP}:${PORT}"
fi

echo "Debug:"
echo "  Receiver: tmux attach -t ${RX_SESSION}"

if [ "$MODE" = "pull" ]; then
    echo "  Sender  : ssh ${REMOTE} -t 'tmux attach -t ${TX_SESSION}'"
else
    echo "  Sender  : tmux attach -t ${TX_SESSION}"
fi

echo ""