###############################################################################
#              makefile for a single test                                     #
#                                                                             #
# Command:                                                                    #
# $ make -f Makefile.one t=<full-path-to-test>                                #
#                                                                             #
# options:                                                                    #
#   TESTLIBS: Can include `TESTLIBS=-l<lib> where lib is a library needed by  #
#             this test, which will be += to LDLIBS.                          #
#                                                                             #
# notes:                                                                      #
#   -- normally do not need to edit this file for new tests                   #
#   -- add conditionals if setuid required, using thSetuid_tests as a guide   #
#   -- can not include precompiled header as tests need to define things      #
#      differently in many cases                                              #
#                                                                             #
###############################################################################



.DEFAULT_GOAL := all

TESTS_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SELF_DIR := $(TESTS_DIR)
include $(SELF_DIR)/../Make/common.mk

# Shared test support headers, including EDT SDK stubs for SDK-less builds.
CPPFLAGS += -I$(TESTS_DIR)

# Single-file app name can be supplied as `TARGET=`,
# or `t=` for short
TARGET ?= $(t)

#allow passing of .o, .hpp, or no extension
BASENAME=$(basename $(TARGET))
PATHNAME=$(dir $(TARGET))
OBJNAME = $(PATHNAME)$(notdir $(BASENAME)).o
TESTNAME = $(PATHNAME)$(notdir $(BASENAME))
EDT_TESTS = ocam2KCtrl_test ocam2KCtrl_emgain_test ocam2KCtrl_lifecycle_test ocam2KCtrl_temperature_test ocam2KCtrl_housekeeping_test ocam2KCtrl_reconfig_test ocam2KCtrl_descramble_test cred2Ctrl_test cred2Ctrl_lifecycle_test

# add extra libraries for special cases

ifeq ($(notdir $(TESTNAME)),acronameUsbHub_test)
	CPPFLAGS += -I$(TESTS_DIR)/../libs/BrainStem2
else ifeq ($(notdir $(TESTNAME)),dlDataCollection_test)
	LDLIBS += -lcrypto
	CXXFLAGS += -fno-fast-math
else ifeq ($(notdir $(TESTNAME)),kcubeCtrl_test)
    TMC_CONTROLLER_PATH ?= /opt/MagAOX/source/tmcController
    FTDI_CFLAGS ?= $(shell pkg-config --cflags libftdi1)
    CPPFLAGS += -I$(TMC_CONTROLLER_PATH) -I$(TMC_CONTROLLER_PATH)/tests $(FTDI_CFLAGS)
    $(OBJNAME): $(PATHNAME)../kcubeCtrl.hpp $(TMC_CONTROLLER_PATH)/tmcController.hpp $(TMC_CONTROLLER_PATH)/tests/ftdiHarness.hpp
else ifeq ($(notdir $(TESTNAME)),cursesINDI_test)
	OTHER_HEADERS += cursesTableGrid.hpp
	LDLIBS += -lncurses
else ifeq ($(notdir $(TESTNAME)),logdump_test)
	LDLIBS = -lmxlib -lflatbuffers
else ifeq ($(notdir $(TESTNAME)),logstream_test)
	LDLIBS = -lmxlib -lflatbuffers
else ifeq ($(notdir $(TESTNAME)),logsurgeon_test)
	LDLIBS = -lmxlib -lflatbuffers
else ifneq ($(filter $(notdir $(TESTNAME)),pupilFit_test frameGrabberTelemetry_test frameGrabberTraceTelemetry_test dmTimingTelemetry_test dmSyncoTelemetry_test dmPipelineTelemetry_test gpuTelemetry_test irqTelemetry_test raidTelemetry_test sysMonitorDiagnostics_test),)
	LDLIBS += -lflatbuffers
else ifneq ($(filter $(notdir $(TESTNAME)),bmcCtrl_test alpaoCtrl_test irisaoCtrl_test),)
	# Offline DM tests use their local SDK declarations and software function stubs.
	CPPFLAGS += -I$(abspath $(PATHNAME)/sdk)
else ifeq ($(notdir $(TESTNAME)),xrif2fits_test)
	LDLIBS += -lcfitsio
else ifeq ($(notdir $(TESTNAME)),xrif2shmim_test)
	LDLIBS += -lcfitsio
else ifeq ($(notdir $(TESTNAME)),mzmqClient_test)
	LDLIBS += -lzmq
else ifeq ($(notdir $(TESTNAME)),mzmqServer_test)
	LDLIBS += -lzmq
else ifeq ($(notdir $(TESTNAME)),xInstGraph_test)
    LDLIBS += -linstGraph
else ifeq ($(notdir $(TESTNAME)),fsmNode_test)
    LDLIBS += -linstGraph
else ifeq ($(notdir $(TESTNAME)),indiPropNode_test)
    LDLIBS += -linstGraph
else ifeq ($(notdir $(TESTNAME)),pwrOnOffNode_test)
    LDLIBS += -linstGraph
else ifeq ($(notdir $(TESTNAME)),staticNode_test)
    LDLIBS += -linstGraph
else ifeq ($(notdir $(TESTNAME)),stdMotionNode_test)
    LDLIBS += -linstGraph
else ifeq ($(notdir $(TESTNAME)),xigNode_test)
    LDLIBS += -linstGraph
else ifneq ($(filter pvcam%_test,$(notdir $(TESTNAME))),)
	# PVCAM SDK stubs; the tests define the library functions.
	CPPFLAGS += -I$(TESTS_DIR)/pvcam
else ifeq ($(notdir $(TESTNAME)),picamCtrl_test)
	# PICam SDK stubs; the tests define the library functions.
	CPPFLAGS += -I$(TESTS_DIR)/picam
else ifeq ($(notdir $(TESTNAME)),ocamDescrambler_test)
    # Pixel equivalence needs the real SDK, isolated from app-test function stubs.
    OCAM_DESCRAMBLE_SDK = $(PATHNAME)ocamDescrambler_sdk.o
    EXTRA_TEST_OBJS += $(OCAM_DESCRAMBLE_SDK)
    $(OBJNAME): $(PATHNAME)../ocamDescrambler.hpp $(PATHNAME)ocamDescrambleFixture.hpp
    $(OCAM_DESCRAMBLE_SDK): $(PATHNAME)../fli/ocam2_sdk.c $(PATHNAME)../fli/ocam2_sdk.h $(PATHNAME)../fli/ocam2_pvt.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -DOCAMSDK_VERSION=\"2\" -DOCAMSDK_BUILD=\"0\" -c $< -o $@
else ifneq ($(filter $(notdir $(TESTNAME)),$(EDT_TESTS)),)
	CXXFLAGS := $(filter-out -DMAGAOX_NOEDT,$(CXXFLAGS))
	CFLAGS := $(filter-out -DMAGAOX_NOEDT,$(CFLAGS))
	CPPFLAGS := $(filter-out -DMAGAOX_NOEDT,$(CPPFLAGS))
endif

ifeq ($(notdir $(TESTNAME)),ocam2KCtrl_descramble_test)
    $(OBJNAME): $(PATHNAME)../ocam2KCtrl.hpp $(PATHNAME)../ocamDescrambler.hpp $(PATHNAME)../ocamDescrambleParallel.hpp $(PATHNAME)../ocamDescramblePlacement.hpp $(PATHNAME)ocam2KCtrl_test.cpp $(PATHNAME)ocamDescrambleFixture.hpp
endif

ifeq ($(notdir $(TESTNAME)),ocamDescramblePlacement_test)
    $(OBJNAME): $(PATHNAME)../ocamDescramblePlacement.hpp
endif

LDLIBS+=$(TESTLIBS)



######################
# setuid             #
######################
#Special handling for tests requiring setuid
ifeq ($(notdir $(TESTNAME)),thSetuid_test)
   SETUID=sudo chown root:root $(TESTNAME) && sudo chmod u+s $(TESTNAME)
endif


all: magaox_git_version.h $(TESTNAME) pcommand

# The entrypoint suite launches the real app; always match its instrumentation
# to this test build. Clear inherited make flags so a test's -B does not force
# a rebuild of all shared dependencies; COVERAGE is passed explicitly.
ifneq ($(filter $(notdir $(TESTNAME)),flipperCtrl_entrypoint_test streamWriter_entrypoint_test),)
ENTRYPOINT_APP = $(patsubst %_entrypoint_test,%,$(notdir $(TESTNAME)))
.PHONY: entrypoint_app
$(TESTNAME): | entrypoint_app
entrypoint_app:
	MAKEFLAGS= $(MAKE) -C $(TESTS_DIR)/../apps/$(ENTRYPOINT_APP) -W $(ENTRYPOINT_APP).cpp COVERAGE=$(COVERAGE)
endif

$(TESTNAME): $(OBJNAME) testMain.o $(EXTRA_TEST_OBJS)
	$(LINK.o) -o $(TESTNAME) testMain.o $(OBJNAME) $(EXTRA_TEST_OBJS) $(abspath $(SELF_DIR)/../libMagAOX/libMagAOX.a) $(LDFLAGS) $(LDLIBS)
	$(SETUID)

##################################################
# Force, without building all of catch2 using -B
#
# for this to work TARGET must include .cpp
#################################################
force:
	@echo $(TARGET)
	@touch $(TARGET)
	$(MAKE) -f Makefile.one all

#This just prints the command name, primarily to allow easy access for running a single test
.PHONY: pcommand
pcommand:
	@echo "Command to run test: " $(TESTNAME)

.PHONY: magaox_git_version.h
magaox_git_version.h:
	@gengithead.sh $(abspath $(SELF_DIR)/../) $(SELF_DIR)/../magaox_git_version.h MAGAOX

.PHONY: clean
clean:
	@echo cleaning $(TESTNAME)
	@rm -f $(OBJNAME)
	@rm -f $(EXTRA_TEST_OBJS)
	@rm -f $(TESTNAME)
	@rm -f *.binlog


.PHONY: realclean
realclean: clean
	@rm -f testMain.o
