/* Generated by tests/genTestMacros.py from {{namesFile}}. Do not edit. To add a name edit
 * that file and rerun the generator. See tests/genTestMacros.md for how these macros are
 * used by production code and by the unit tests. */

{# Template for the XWCTEST_IF_<NAME> fault injection macros. It is rendered by
   tests/genTestMacros.py with trim_blocks and lstrip_blocks on. Text outside these
   Jinja comment blocks goes straight into the generated C++ header. The banner above
   marks the generated header as not hand-editable and names its source.
   Each name gets one macro, XWCTEST_IF_<NAME>(line), which runs the statement inside
   its own block.
   Variables: xwcTestNames is the list of names with the XWCTEST_ prefix stripped,
   namesFile is the repo relative path of the names file. #}
{% for xwcTestName in xwcTestNames %}

{# Each name gets one macro. The #undef allows the header to be included more than once.
   When the test translation unit has defined XWCTEST_<NAME>, the macro runs the given
   line inside a block. LCOV_EXCL_LINE hides that line from coverage. The clang-format
   comments keep the formatter from rewrapping the macro body. Otherwise the macro is
   an empty statement, which is what production builds always get. #}
#undef XWCTEST_IF_{{xwcTestName}}
#ifdef XWCTEST_{{xwcTestName}}
#define XWCTEST_IF_{{xwcTestName}}(line) \
/* clang-format off */ \
{ line ; } /* LCOV_EXCL_LINE */ \
/* clang-format on */
#else
#define XWCTEST_IF_{{xwcTestName}}(line) do {} while(0)
#endif

{% endfor %}
